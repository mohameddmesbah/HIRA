{{ 'hira-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hira-configurator.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sid = section.id
  assign layer_keys = 'mannequin,mask_eyes,mask_wide,mouth_simple,mouth_teeth,face_skull,bunny_outer,bunny_inner,bear_outer,bear_inner,cat_outer,cat_inner,horns,stripe' | split: ','
  assign wa_number = settings.hira_whatsapp_order | default: '201033189288' | remove: '+' | remove: ' ' | remove: '-'
-%}

<section
  id="design-your-own"
  class="hira-section hira-cfg color-{{ section.settings.color_scheme }} gradient"
  style="--hira-pt: {{ section.settings.padding_top }}px; --hira-pb: {{ section.settings.padding_bottom }}px;"
  data-hira-configurator
>
  <div class="hira-wrap">
    <header class="hira-cfg__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hira-eyebrow" data-hira-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {% render 'hira-heading-reveal', text: section.settings.heading, accent_last: section.settings.accent_last_line, tag: 'h1' %}
      {%- if section.settings.text != blank -%}
        <div class="hira-text rte" data-hira-reveal="fade" style="--d: 2;">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if settings.hira_start_price_text != blank -%}
        <p class="hira-cfg__start-price" data-hira-reveal="fade" style="--d: 3;">{{ settings.hira_start_price_text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="hira-cfg__grid">
      {%- comment -%} Live preview {%- endcomment -%}
      <div class="hira-cfg__stage">
        <div class="hira-cfg__preview">
          <svg
            class="hira-cfg__svg"
            viewBox="-70 -40 540 540"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-labelledby="HiraCfgTitle-{{ sid }}"
            data-cfg-svg
          >
            <title id="HiraCfgTitle-{{ sid }}">Preview of your HIRA mask</title>
          </svg>
          <div class="hira-cfg__piece-tools" data-piece-tools hidden>
            <button type="button" class="hira-cfg__piece-remove" data-piece-remove>Remove</button>
          </div>
        </div>

        <div class="hira-cfg__price" aria-live="polite">
          <span class="hira-cfg__price-label">{{ section.settings.price_label | escape }}</span>
          <strong class="hira-cfg__price-value"><span data-cfg-egp>—</span> EGP</strong>
          <span class="hira-cfg__price-usd">(~$<span data-cfg-usd>—</span>)</span>
          <p class="hira-cfg__price-note">{{ section.settings.price_note | escape }}</p>
          <ul class="hira-cfg__breakdown" data-cfg-breakdown role="list"></ul>
        </div>

        <button type="button" class="hira-btn hira-btn--secondary hira-cfg__save" data-cfg-save>
          <span class="hira-btn__label">{{ section.settings.save_label | escape }}</span>
        </button>
        <p class="hira-cfg__status" data-cfg-status role="status"></p>
      </div>

      {%- comment -%} Steps {%- endcomment -%}
      <div class="hira-cfg__panel">
        <ol class="hira-cfg__progress" role="list" data-cfg-progress>
          <li>Color</li><li>Openings</li><li>Ears</li><li>Extras</li><li>Stripes</li><li>Details</li>
        </ol>

        <form class="hira-cfg__form" data-cfg-form novalidate>
          <fieldset class="hira-cfg__step" data-step="1">
            <legend class="hira-cfg__legend"><span>01</span> Base color</legend>
            <div class="hira-cfg__swatches" data-swatches="base"></div>
          </fieldset>

          <fieldset class="hira-cfg__step" data-step="2" hidden>
            <legend class="hira-cfg__legend"><span>02</span> Openings</legend>
            <p class="hira-cfg__sublabel">Eyes</p>
            <div class="hira-cfg__options">
              <label class="hira-cfg__option"><input type="radio" name="opening" value="wide"><span>One wide</span></label>
              <label class="hira-cfg__option"><input type="radio" name="opening" value="eyes" checked><span>Two eyes</span></label>
            </div>
            <div class="hira-cfg__sub">
              <p class="hira-cfg__sublabel">Mouth</p>
              <div class="hira-cfg__options">
                <label class="hira-cfg__option"><input type="radio" name="mouth" value="none" checked><span>None</span></label>
                <label class="hira-cfg__option"><input type="radio" name="mouth" value="simple"><span>Simple opening <small data-price-tag="mouth_simple"></small></span></label>
                <label class="hira-cfg__option"><input type="radio" name="mouth" value="teeth"><span>Teeth <small data-price-tag="mouth_teeth"></small></span></label>
                <label class="hira-cfg__option"><input type="radio" name="mouth" value="skull"><span>Skull mask <small data-price-tag="face_skull"></small></span></label>
              </div>
              <div data-mouth-color hidden>
                <p class="hira-cfg__sublabel" style="margin-top: 2rem;">Mouth color</p>
                <div class="hira-cfg__swatches" data-swatches="mouth"></div>
              </div>
              <div data-face-color hidden>
                <p class="hira-cfg__sublabel" style="margin-top: 2rem;">Face piece color</p>
                <div class="hira-cfg__swatches" data-swatches="face"></div>
              </div>
            </div>
          </fieldset>

          <fieldset class="hira-cfg__step" data-step="3" hidden>
            <legend class="hira-cfg__legend"><span>03</span> Ears</legend>
            <div class="hira-cfg__options">
              <label class="hira-cfg__option"><input type="radio" name="ears" value="none" checked><span>None</span></label>
              <label class="hira-cfg__option"><input type="radio" name="ears" value="bear"><span>Bear ears <small data-price-tag="bear"></small></span></label>
              <label class="hira-cfg__option"><input type="radio" name="ears" value="bunny"><span>Bunny ears <small data-price-tag="bunny"></small></span></label>
              <label class="hira-cfg__option"><input type="radio" name="ears" value="horns"><span>Horns <small data-price-tag="horns"></small></span></label>
              <label class="hira-cfg__option"><input type="radio" name="ears" value="cat"><span>Cat ears <small data-price-tag="cat"></small></span></label>
            </div>
            <div class="hira-cfg__sub" data-ear-colors hidden>
              <p class="hira-cfg__sublabel" data-ear-outer-label>Ear outer color</p>
              <div class="hira-cfg__swatches" data-swatches="earOuter"></div>
              <div data-ear-inner-wrap>
                <p class="hira-cfg__sublabel">Ear inner color</p>
                <div class="hira-cfg__swatches" data-swatches="earInner"></div>
              </div>
            </div>
          </fieldset>

          <fieldset class="hira-cfg__step" data-step="4" hidden>
            <legend class="hira-cfg__legend"><span>04</span> Accessories <small>Choose any</small></legend>
            <p class="hira-cfg__hint">Each one appears on your mask: drag it anywhere on the mask or ears. Tap a piece to remove it.</p>
            <div class="hira-cfg__acc-list">
              <div class="hira-cfg__acc" data-acc-row="chain">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="chain"><span>Steel chain <small data-price-tag="chain" data-price-suffix=" per chain"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="chain">+ Add another</button>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="rings">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="rings"><span>Metal rings <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="rings">+ Add another</button>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="crystals">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="crystals"><span>Crystals <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="crystals">+ Add another</button>
                </div>
                <div class="hira-cfg__acc-extra" data-crystal-color hidden>
                  <span>Crystal color</span>
                  <label class="hira-cfg__mini"><input type="radio" name="crystalColor" value="red" checked><span>Red</span></label>
                  <label class="hira-cfg__mini"><input type="radio" name="crystalColor" value="black"><span>Black</span></label>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="charms">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="charms"><span>Heart &amp; bow charms <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="charms">+ Add another</button>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="stars">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="stars"><span>Stars <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="stars">+ Add another</button>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="hearts">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="hearts"><span>Hearts <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="hearts">+ Add another</button>
                </div>
              </div>
              <div class="hira-cfg__acc" data-acc-row="pearls">
                <label class="hira-cfg__option"><input type="checkbox" name="acc" value="pearls"><span>Pearls / beads <small data-price-tag="accessory" data-price-suffix=" per piece"></small></span></label>
                <div class="hira-cfg__acc-tools" data-acc-tools hidden>
                  <span class="hira-cfg__acc-count" data-acc-count></span>
                  <button type="button" class="hira-cfg__acc-add" data-acc-add="pearls">+ Add another</button>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="hira-cfg__step" data-step="5" hidden>
            <legend class="hira-cfg__legend"><span>05</span> Stripes &amp; accent</legend>
            <p class="hira-cfg__sublabel">Side stripes <small data-price-tag="stripe" data-price-suffix=" per stripe"></small></p>
            <div class="hira-cfg__stepper" data-cfg-stepper>
              <button type="button" class="hira-cfg__stepper-btn" data-stripes-minus aria-label="Fewer stripes">&minus;</button>
              <output class="hira-cfg__stepper-value" data-stripes-value aria-live="polite">0</output>
              <button type="button" class="hira-cfg__stepper-btn" data-stripes-plus aria-label="More stripes">+</button>
              <span class="hira-cfg__stepper-label">stripes (0–8)</span>
            </div>
            <div data-stripe-color hidden>
              <p class="hira-cfg__sublabel" style="margin-top: 2rem;">Stripe color</p>
              <div class="hira-cfg__swatches" data-swatches="stripe"></div>
            </div>
            <div class="hira-cfg__sub">
              <p class="hira-cfg__sublabel">Accent color <small>Optional</small> <small data-price-tag="accent"></small></p>
              <p class="hira-cfg__hint">Used for trims, the neck stripe and details like stars, hearts and the bow.</p>
              <div class="hira-cfg__swatches" data-swatches="accent"></div>
            </div>
          </fieldset>

          <fieldset class="hira-cfg__step" data-step="6" hidden>
            <legend class="hira-cfg__legend"><span>06</span> Your details</legend>
            <div class="hira-cfg__fields">
              <label class="hira-cfg__field">
                <span>Full name *</span>
                <input type="text" name="name" autocomplete="name" required>
                <small class="hira-cfg__error" data-error-for="name">Please enter your name.</small>
              </label>
              <label class="hira-cfg__field">
                <span>WhatsApp number (with country code) *</span>
                <input type="tel" name="whatsapp" autocomplete="tel" inputmode="tel" placeholder="+20 10 1234 5678" required>
                <small class="hira-cfg__error" data-error-for="whatsapp">Enter your number with the country code, e.g. +20 10 1234 5678.</small>
              </label>
              <label class="hira-cfg__field">
                <span>Country *</span>
                <input type="text" name="country" autocomplete="country-name" required>
                <small class="hira-cfg__error" data-error-for="country">Please enter your country.</small>
              </label>
              <label class="hira-cfg__field">
                <span>City *</span>
                <input type="text" name="city" autocomplete="address-level2" required>
                <small class="hira-cfg__error" data-error-for="city">Please enter your city.</small>
              </label>
              <div class="hira-cfg__field">
                <label for="HiraCfgHead-{{ sid }}">Head circumference (cm) *</label>
                <input type="number" id="HiraCfgHead-{{ sid }}" name="head" inputmode="decimal" min="35" max="75" step="0.5" placeholder="e.g. 56" required>
                <small class="hira-cfg__error" data-error-for="head">Enter a measurement between 35 and 75 cm.</small>
                <div class="hira-cfg__measure">
                  <div class="hira-cfg__measure-text">
                    <small class="hira-cfg__note">{{ section.settings.measure_note | escape }}</small>
                    {%- if section.settings.measure_range != blank -%}
                      <small class="hira-cfg__note hira-cfg__note--strong">{{ section.settings.measure_range | escape }}</small>
                    {%- endif -%}
                  </div>
                  {%- if settings.hira_measure_image != blank -%}
                    <button type="button" class="hira-cfg__measure-thumb" data-measure-open aria-haspopup="dialog" aria-label="How to measure: view larger">
                      {{
                        settings.hira_measure_image
                        | image_url: width: 480
                        | image_tag: loading: 'lazy', width: 120, alt: settings.hira_measure_image.alt | default: 'How to measure your head'
                      }}
                      <span class="hira-cfg__measure-zoom">How to measure</span>
                    </button>
                  {%- endif -%}
                </div>
              </div>
              <label class="hira-cfg__field">
                <span>Email <em>(optional, for a copy of your order)</em></span>
                <input type="email" name="email" autocomplete="email">
                <small class="hira-cfg__error" data-error-for="email">Please check your email address.</small>
              </label>
              <label class="hira-cfg__field hira-cfg__field--wide">
                <span>Notes</span>
                <textarea name="notes" rows="4" placeholder="References, size details, anything we should know"></textarea>
              </label>
            </div>
            <div class="hira-cfg__howto">
              {%- if section.settings.howto_heading != blank -%}
                <p class="hira-cfg__howto-title">{{ section.settings.howto_heading | escape }}</p>
              {%- endif -%}
              <ol class="hira-cfg__howto-list">
                {%- if section.settings.howto_step_1 != blank -%}<li>{{ section.settings.howto_step_1 | escape }}</li>{%- endif -%}
                {%- if section.settings.howto_step_2 != blank -%}<li>{{ section.settings.howto_step_2 | escape }}</li>{%- endif -%}
              </ol>
            </div>
            <button type="button" class="hira-btn hira-btn--secondary hira-cfg__save hira-cfg__save--final" data-cfg-save>
              <span class="hira-btn__label">1. {{ section.settings.save_label | escape }}</span>
              <span class="hira-cfg__saved" data-cfg-saved hidden>{{ section.settings.saved_label | escape }}</span>
            </button>
            <button type="button" class="hira-btn hira-btn--primary hira-cfg__send" data-cfg-send>
              <span class="hira-btn__label">2. {{ section.settings.send_label | escape }}</span>
            </button>
            <div class="hira-cfg__remind" data-cfg-remind hidden role="alertdialog" aria-labelledby="HiraCfgRemind-{{ sid }}">
              <p id="HiraCfgRemind-{{ sid }}">{{ section.settings.remind_text | escape }}</p>
              <div class="hira-cfg__remind-actions">
                <button type="button" class="hira-btn hira-btn--secondary" data-cfg-remind-save>Save now</button>
                <button type="button" class="hira-btn hira-btn--ghost" data-cfg-remind-continue>Continue anyway</button>
              </div>
            </div>
            <p class="hira-cfg__hint">{{ section.settings.send_note | escape }}</p>

            <div class="hira-cfg__confirm" data-cfg-confirm hidden tabindex="-1" role="status" aria-live="polite">
              {%- if settings.hira_confirm_heading != blank -%}
                <h2 class="hira-cfg__confirm-title">{{ settings.hira_confirm_heading | escape }}</h2>
              {%- endif -%}
              {%- if settings.hira_confirm_text != blank -%}
                <p>{{ settings.hira_confirm_text | escape }}</p>
              {%- endif -%}
              {%- if settings.hira_confirm_deposit != blank -%}
                <p class="hira-cfg__confirm-deposit">{{ settings.hira_confirm_deposit | escape }}</p>
              {%- endif -%}
              <ul class="hira-cfg__confirm-pay" role="list">
                {%- if settings.hira_confirm_egypt_text != blank or settings.hira_payment_number != blank -%}
                  <li>
                    <strong>{{ settings.hira_confirm_egypt_label | escape }}:</strong>
                    {{ settings.hira_confirm_egypt_text | escape }}
                    {%- if settings.hira_payment_number != blank %}
                      <span class="hira-cfg__pay-number" data-pay-number>{{ settings.hira_payment_number | escape }}</span>.
                      <button type="button" class="hira-cfg__copy" data-copy-number>Copy number</button>
                    {%- endif -%}
                  </li>
                {%- endif -%}
                {%- if settings.hira_confirm_intl_text != blank -%}
                  <li><strong>{{ settings.hira_confirm_intl_label | escape }}:</strong> {{ settings.hira_confirm_intl_text | escape }}</li>
                {%- endif -%}
              </ul>
            </div>
          </fieldset>

          <div class="hira-cfg__nav">
            <button type="button" class="hira-btn hira-btn--ghost" data-cfg-back>Back</button>
            <button type="button" class="hira-btn hira-btn--primary" data-cfg-next>Next</button>
          </div>
        </form>

        {%- if settings.hira_measure_image != blank -%}
          <dialog class="hira-cfg__lightbox" data-measure-dialog aria-label="How to measure your head">
            <button type="button" class="hira-cfg__lightbox-close" data-measure-close aria-label="Close">&times;</button>
            {{
              settings.hira_measure_image
              | image_url: width: 1600
              | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 750px) 80vw, 100vw',
                loading: 'lazy',
                alt: settings.hira_measure_image.alt | default: 'How to measure your head'
            }}
          </dialog>
        {%- endif -%}

        {%- if settings.hira_show_cal_link and settings.hira_cal_link != blank -%}
          <p class="hira-cfg__cal">
            Prefer to talk it through first?
            {% render 'hira-cal-link' %}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Silent email copy via Shopify's contact form {%- endcomment -%}
  <div class="hira-cfg__contact" hidden>
    {%- form 'contact', id: 'HiraCfgContact' -%}
      <input type="hidden" name="contact[name]">
      <input type="hidden" name="contact[email]">
      <input type="hidden" name="contact[phone]">
      <input type="hidden" name="contact[body]">
    {%- endform -%}
  </div>

  <script type="application/json" data-cfg-config>
    {
      "whatsapp": {{ wa_number | json }},
      "colors": [
        { "name": "Black", "hex": {{ settings.hira_color_black | json }} },
        { "name": "Grey", "hex": {{ settings.hira_color_grey | json }} },
        { "name": "White", "hex": {{ settings.hira_color_white | json }} },
        { "name": "Beige", "hex": {{ settings.hira_color_beige | json }} },
        { "name": "Brown", "hex": {{ settings.hira_color_brown | json }} },
        { "name": "Red", "hex": {{ settings.hira_color_red | json }} },
        { "name": "Pink", "hex": {{ settings.hira_color_pink | json }} },
        { "name": "Orange", "hex": {{ settings.hira_color_orange | json }} },
        { "name": "Blue", "hex": {{ settings.hira_color_blue | json }} }
      ],
      "layers": {
        {%- for key in layer_keys -%}
          {%- liquid
            assign k = 'hira_layer_' | append: key
            assign kx = k | append: '_x'
            assign ky = k | append: '_y'
            assign ks = k | append: '_scale'
            assign ksp = k | append: '_spread'
            assign layer_image = settings[k]
          -%}
          {{ key | json }}: {
            "url": {% if layer_image != blank %}{{ layer_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
            "x": {{ settings[kx] | default: 0 | json }},
            "y": {{ settings[ky] | default: 0 | json }},
            "scale": {{ settings[ks] | default: 100 | json }},
            "spread": {{ settings[ksp] | default: 0 | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      "stripeSpacing": {{ settings.hira_layer_stripe_spacing | default: 14 | json }},
      "usdRate": {{ settings.hira_price_usd_rate | default: 56 | json }},
      "prices": {
        "base": {{ settings.hira_price_base | default: 0 | json }},
        "bunny": {{ settings.hira_price_bunny | default: 0 | json }},
        "cat": {{ settings.hira_price_cat | default: 0 | json }},
        "bear": {{ settings.hira_price_bear | default: 0 | json }},
        "horns": {{ settings.hira_price_horns | default: 0 | json }},
        "mouth_simple": {{ settings.hira_price_mouth_simple | default: 0 | json }},
        "mouth_teeth": {{ settings.hira_price_mouth_teeth | default: 0 | json }},
        "face_skull": {{ settings.hira_price_face_skull | default: 0 | json }},
        "stripe": {{ settings.hira_price_stripe | default: 0 | json }},
        "chain": {{ settings.hira_price_chain | default: 0 | json }},
        "accessory": {{ settings.hira_price_accessory | default: 0 | json }},
        "accent": {{ settings.hira_price_accent | default: 0 | json }}
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "HIRA design your own",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Design your own"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Idea.\nHer Hands.\nYour Mask."
    },
    {
      "type": "checkbox",
      "id": "accent_last_line",
      "label": "Highlight last line",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Build your mask step by step and see it come to life. Send it to us on WhatsApp and we'll confirm the details and the final price.</p>"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Save button label",
      "default": "Save my design"
    },
    {
      "type": "text",

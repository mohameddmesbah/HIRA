{%- liquid
  assign compact = false
  if section.settings.layout == 'compact'
    assign compact = true
  endif

  assign has_bg = false
  if compact == false and section.settings.image_1 != blank
    assign has_bg = true
  endif

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign secondary_link = section.settings.secondary_link | default: '#faq'
  assign design_link = section.settings.button_link | default: settings.hira_design_page | default: '/pages/design-your-own'
-%}

<section
  id="custom-made"
  class="hira-section hira-custom hira-custom--{{ section.settings.layout }}{% if has_bg %} hira-custom--has-bg{% endif %} color-{{ section.settings.color_scheme }} gradient"
  style="--hira-pt: {{ section.settings.padding_top }}px; --hira-pb: {{ section.settings.padding_bottom }}px; --hira-overlay-color: {{ section.settings.overlay_color }}; --hira-overlay-alpha: {{ overlay_alpha }}; --hira-bg-focus: {{ section.settings.image_focus }};"
>
  {%- if has_bg -%}
    <div class="hira-custom__bg" aria-hidden="true">
      <div class="hira-custom__bg-inner" data-hira-parallax="0.1">
        {{
          section.settings.image_1
          | image_url: width: 2400
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: ''
        }}
      </div>
    </div>
    <div class="hira-custom__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hira-wrap hira-custom__inner">
    <div class="hira-custom__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hira-eyebrow" data-hira-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {% render 'hira-heading-reveal',
        text: section.settings.heading,
        accent_last: section.settings.accent_last_line
      %}

      {%- if section.settings.text != blank -%}
        <div class="hira-text rte" data-hira-reveal="fade" style="--d: 2;">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hira-actions" data-hira-reveal="fade" style="--d: 3;">
        {% render 'hira-button',
          label: section.settings.button_label,
          link: design_link,
          style: 'primary'
        %}
        {%- if compact -%}
          {% render 'hira-button',
            label: section.settings.secondary_label,
            link: section.settings.secondary_link,
            style: 'ghost'
          %}
        {%- endif -%}
      </div>
      {%- if settings.hira_show_cal_link -%}
        <p class="hira-custom__cal" data-hira-reveal="fade" style="--d: 4;">
          {% render 'hira-cal-link', label: section.settings.cal_label %}
        </p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 and compact == false -%}
      <ol class="hira-steps" role="list">
        {%- for block in section.blocks -%}
          <li class="hira-step" {{ block.shopify_attributes }} data-hira-reveal="fade" style="--d: {{ forloop.index | plus: 3 }};">
            <span class="hira-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3 class="hira-step__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="hira-step__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- unless compact -%}
      {%- if section.settings.secondary_label != blank -%}
        <div class="hira-custom__more" data-hira-reveal="fade">
          {% render 'hira-button',
            label: section.settings.secondary_label,
            link: secondary_link,
            style: 'ghost'
          %}
        </div>
      {%- endif -%}
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "HIRA custom made",
  "tag": "div",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "background", "label": "Full section with background image" },
        { "value": "compact", "label": "Compact (text only)" }
      ],
      "default": "background"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Custom made"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Idea.\nHer Hands.\nYour Mask."
    },
    {
      "type": "checkbox",
      "id": "accent_last_line",
      "label": "Highlight last line",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Your vision, your references, your measurements. Crafted around you, from the first sketch to the final stitch.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Design Your Own",
      "info": "Sits right after the text."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to use the Design Your Own page from Theme settings > HIRA."
    },
    {
      "type": "text",
      "id": "cal_label",
      "label": "Cal.com text link",
      "default": "Or book a design session call",
      "info": "Small optional link under the button. Hide it in Theme settings > HIRA."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Read the FAQ"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link",
      "info": "Leave empty to jump to the FAQ section on the same page."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main image",
      "info": "Covers the whole section, behind a dark overlay. Vertical handcraft images work well."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#1C1822"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 40,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "info": "Higher keeps the text easier to read.",
      "default": 82
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Consult"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Share your idea, references and measurements in a design session."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HIRA custom made",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Consult",
            "text": "Book a design session and share your idea, references and measurements."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sketch",
            "text": "We sketch, choose fibres and colours, and refine the design together."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Stitch",
            "text": "Your mask is crocheted or knitted by hand, then finished and sent to you."
          }
        }
      ]
    }
  ]
}
{% endschema %}

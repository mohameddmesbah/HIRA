{%- liquid
  assign compact = false
  if section.settings.layout == 'compact'
    assign compact = true
  endif
-%}

<section
  id="custom-made"
  class="hira-section hira-custom hira-custom--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient"
  style="--hira-pt: {{ section.settings.padding_top }}px; --hira-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="hira-wrap">
    <div class="hira-custom__grid">
      <div class="hira-custom__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hira-eyebrow" data-hira-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {% render 'hira-heading-reveal',
          text: section.settings.heading,
          accent_last: section.settings.accent_last_line
        %}

        {%- if section.settings.text != blank -%}
          <div class="hira-text rte" data-hira-reveal="fade" style="--d: 2;">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 and compact == false -%}
          <ol class="hira-steps" role="list">
            {%- for block in section.blocks -%}
              <li class="hira-step" {{ block.shopify_attributes }} data-hira-reveal="fade" style="--d: {{ forloop.index | plus: 2 }};">
                <span class="hira-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <div>
                  <h3 class="hira-step__title">{{ block.settings.title | escape }}</h3>
                  {%- if block.settings.text != blank -%}
                    <p class="hira-step__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <div class="hira-actions" data-hira-reveal="fade" style="--d: 4;">
          {% render 'hira-button',
            label: section.settings.button_label,
            booking: true,
            style: 'primary'
          %}
          {%- assign secondary_link = section.settings.secondary_link | default: '#faq' -%}
          {% render 'hira-button',
            label: section.settings.secondary_label,
            link: secondary_link,
            style: 'ghost'
          %}
        </div>
      </div>

      {%- unless compact -%}
        <div class="hira-custom__collage" aria-hidden="true">
          <div class="hira-custom__img--a hira-media" data-hira-reveal="mask">
            <div data-hira-parallax="0.12" style="position:absolute;inset:-8% 0;">
              {%- if section.settings.image_1 != blank -%}
                {{
                  section.settings.image_1
                  | image_url: width: 1400
                  | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 36vw, 72vw', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
          <div class="hira-custom__img--b hira-media" data-hira-reveal="mask" style="--d: 2;">
            {%- if section.settings.image_2 != blank -%}
              {{
                section.settings.image_2
                | image_url: width: 1000
                | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: ''
              }}
            {%- else -%}
              {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <svg class="hira-thread" viewBox="0 0 500 600" preserveAspectRatio="none" focusable="false" data-hira-reveal="thread">
            <path pathLength="1" d="M20 560 C 120 420, 40 300, 200 260 S 420 160, 480 30"/>
          </svg>

          {%- if section.settings.stamp_text != blank -%}
            <div class="hira-custom__stamp">
              <svg viewBox="0 0 100 100" width="100%" height="100%" focusable="false">
                <defs>
                  <path id="HiraStamp-{{ section.id }}" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/>
                </defs>
                <circle cx="50" cy="50" r="3" fill="var(--hira-accent)"/>
                <text><textPath href="#HiraStamp-{{ section.id }}">{{ section.settings.stamp_text | escape }}</textPath></text>
              </svg>
            </div>
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HIRA custom made",
  "tag": "div",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "media-right", "label": "Images on the right" },
        { "value": "media-left", "label": "Images on the left" },
        { "value": "compact", "label": "Compact (text only)" }
      ],
      "default": "media-right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Custom made"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Idea.\nHer Hands.\nYour Mask."
    },
    {
      "type": "checkbox",
      "id": "accent_last_line",
      "label": "Highlight last line",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Your vision, your references, your measurements. Crafted around you, from the first sketch to the final stitch.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Booking button label",
      "default": "Book a Design Session",
      "info": "Opens the Cal.com booking set in Theme settings > HIRA."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Read the FAQ"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link",
      "info": "Leave empty to jump to the FAQ section on the same page."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Detail image"
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "Rotating stamp text",
      "default": "Made to measure • Made by hand • "
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Consult"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Share your idea, references and measurements in a design session."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HIRA custom made",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Consult",
            "text": "Book a design session and share your idea, references and measurements."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sketch",
            "text": "We sketch, choose fibres and colours, and refine the design together."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Stitch",
            "text": "Your mask is knotted and stitched by hand, then finished and sent to you."
          }
        }
      ]
    }
  ]
}
{% endschema %}

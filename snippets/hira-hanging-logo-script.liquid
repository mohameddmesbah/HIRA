{% comment %}
  Measures everything in the header group above the header (the announcement bar)
  and exposes it as --hira-ann-h, so the hanging logo can reach up to the very
  top of the page. Rendered inline from sections/header.liquid, before the header
  markup: the announcement bar is already parsed, so the first paint is correct.
{% endcomment %}
<script>
  (function () {
    var root = document.documentElement;
    var observer = window.ResizeObserver ? new ResizeObserver(measure) : null;

    function sectionsAbove() {
      var header = document.querySelector('.section-header');
      var list = [];
      if (!header) return list;
      var el = header.previousElementSibling;
      while (el) {
        if (el.classList && el.classList.contains('shopify-section')) list.push(el);
        el = el.previousElementSibling;
      }
      return list;
    }

    function measure() {
      var sections = sectionsAbove();
      var total = 0;
      sections.forEach(function (section) {
        total += section.getBoundingClientRect().height;
      });
      root.style.setProperty('--hira-ann-h', Math.round(total) + 'px');

      // If the bar reaches below the rope into the letters, keep the text clear of
      // the whole logo. Stable: the wider gap only ever makes the bar taller.
      var img = document.querySelector('.hira-hanging-logo__img');
      var share = parseFloat(getComputedStyle(root).getPropertyValue('--hira-rope-share')) || 0.45;
      if (img) {
        var ropeOnly = img.getBoundingClientRect().height * share;
        root.classList.toggle('hira-ann-clear-logo', ropeOnly > 0 && total > ropeOnly - 2);
      }
    }

    function watch() {
      if (observer) observer.disconnect();
      measure();
      if (observer) {
        sectionsAbove().forEach(function (section) { observer.observe(section); });
        var img = document.querySelector('.hira-hanging-logo__img');
        if (img) observer.observe(img);
      }
    }

    watch();
    document.addEventListener('DOMContentLoaded', watch);
    window.addEventListener('load', measure);
    if (!observer) window.addEventListener('resize', measure);
    document.addEventListener('shopify:section:load', watch);
    document.addEventListener('shopify:section:unload', function () { setTimeout(watch, 0); });
  })();
</script>

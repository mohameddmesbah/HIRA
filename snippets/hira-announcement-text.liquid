{% comment %}
  Announcement text. With the hanging logo on, the same text is split into two
  halves with a gap where the rope hangs, so the rope never covers any words.
  Splits at a separator (·, •, |, –, -) when there is one, otherwise at the
  middle word. Without the hanging logo it renders exactly like Dawn.

  Accepts:
  - text: {String} the announcement text (required)

  Usage:
  {% render 'hira-announcement-text', text: block.settings.text %}
{% endcomment %}

{%- liquid
  assign split = false
  if settings.hira_logo_hanging and settings.logo != blank
    assign split = true
  endif

  if split
    assign first = ''
    assign second = ''
    assign separators = ' · ~ • ~ | ~ – ~ - ' | split: '~'
    for sep in separators
      if text contains sep
        assign before = text | split: sep | first
        assign rest_start = before.size | plus: sep.size
        assign first = before | append: sep | strip
        assign second = text | slice: rest_start, text.size | strip
        break
      endif
    endfor

    if first == blank or second == blank
      assign words = text | split: ' '
      if words.size > 1
        assign half = words.size | divided_by: 2.0 | ceil
        assign first = ''
        assign second = ''
        for word in words
          if forloop.index <= half
            assign first = first | append: word | append: ' '
          else
            assign second = second | append: word | append: ' '
          endif
        endfor
        assign first = first | strip
        assign second = second | strip
      else
        assign split = false
      endif
    endif
  endif
-%}

{%- if split -%}
  <span class="hira-ann-split__a">{{ first | escape }} </span>
  <span class="hira-ann-split__gap" aria-hidden="true"></span>
  <span class="hira-ann-split__b">{{ second | escape }}</span>
{%- else -%}
  <span>{{ text | escape }}</span>
{%- endif -%}
